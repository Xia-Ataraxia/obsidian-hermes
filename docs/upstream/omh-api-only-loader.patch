+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { act, createElement, useEffect } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import type { PluginManifest } from "./types";
+import fixtures from "./api-only-fixtures.json";
+
+const response = vi.hoisted(() => ({ list: [] as PluginManifest[] }));
+vi.mock("@/lib/api", async (original) => {
+  const actual = await original<typeof import("@/lib/api")>();
+  return { ...actual, api: { ...actual.api, getPlugins: async () => response.list } };
+});
+import { usePlugins, cacheManifests } from "./usePlugins";
+import { exposePluginSDK, getPluginLoadError, selectPluginProfile } from "./registry";
+
+Reflect.set(globalThis, "IS_REACT_ACT_ENVIRONMENT", true);
+let root: Root;
+let latest: ReturnType<typeof usePlugins> | undefined;
+function Probe() {
+  const result = usePlugins("task15");
+  useEffect(() => { latest = result; });
+  return createElement("div", null, result.plugins.map((plugin) =>
+    createElement(plugin.component, { key: plugin.manifest.name })));
+}
+beforeEach(() => {
+  sessionStorage.clear();
+  selectPluginProfile("reset");
+  exposePluginSDK();
+  latest = undefined;
+  const container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  document.head.innerHTML = "";
+  document.body.innerHTML = "";
+  vi.restoreAllMocks();
+});
+const fixture = (name: string): PluginManifest => {
+  const value = fixtures.find((item) => item.name === name);
+  if (!value) throw new Error(`Missing normalized fixture ${name}`);
+  return value;
+};
+async function show(list: PluginManifest[]) {
+  response.list = list;
+  await act(async () => root.render(createElement(Probe)));
+}
+
+describe("normalized API-only and browser plugin contracts", () => {
+  it("settles API-only discovery without scripts, styles, or UI routes", async () => {
+    await show([fixture("api-only")]);
+    expect(document.querySelectorAll("script[data-hermes-plugin],link[rel=stylesheet]")).toHaveLength(0);
+    expect(latest?.manifests).toEqual([]);
+    expect(latest?.loading).toBe(false);
+    expect(getPluginLoadError("api-only")).toBeUndefined();
+  });
+  it("discards an API-only cached chat override before initial UI routing", async () => {
+    const api = fixture("api-only");
+    cacheManifests("task15", [{ ...api, tab: { path: "/api-only", override: "/chat" } }]);
+    await show([api]);
+    expect(latest?.manifests).toEqual([]);
+    expect(latest?.loading).toBe(false);
+    expect(document.querySelectorAll("script[data-hermes-plugin]")).toHaveLength(0);
+  });
+  it.each(["hidden", "explicit", "legacy"])("loads and renders %s UI while API-only is present", async (name) => {
+    const browser = fixture(name);
+    await show([fixture("api-only"), browser]);
+    const script = document.querySelector<HTMLScriptElement>(`script[data-hermes-plugin="${name}"]`);
+    expect(script?.src).toContain(`/dashboard-plugins/@task15/${name}/${browser.entry}`);
+    Object.defineProperty(document, "currentScript", { configurable: true, get: () => script });
+    try {
+      const sdk = window.__HERMES_PLUGINS__;
+      if (!sdk) throw new Error("SDK missing");
+      await act(async () => sdk.register(name, () => createElement("p", null, `${name} rendered`)));
+    } finally {
+      Reflect.deleteProperty(document, "currentScript");
+    }
+    expect(document.body.textContent).toContain(`${name} rendered`);
+    expect(latest?.loading).toBe(false);
+  });
+  it("retains a useful load error for an explicitly missing browser entry", async () => {
+    const warning = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+    await show([fixture("missing")]);
+    const script = document.querySelector('script[data-hermes-plugin="missing"]');
+    if (!script) throw new Error("Missing script injection");
+    await act(async () => { script.dispatchEvent(new Event("error")); });
+    expect(getPluginLoadError("missing")).toBe("LOAD_FAILED");
+    expect(warning).toHaveBeenCalledWith(expect.stringContaining("missing.js"));
+  });
+});
