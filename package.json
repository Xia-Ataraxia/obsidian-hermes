{
	"name": "obsidian-hermes",
	"version": "1.0.10",
	"private": true,
	"description": "Obsidian plugin to monitor and manage remote Hermes Agent profiles over SSH.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"lint": "eslint .",
		"test": "bun test",
		"ci": "bun run build && bun run typecheck && bun run lint && bun run test",
		"release": "curl -fsSL https://raw.githubusercontent.com/GoBeromsu/obsidian-boiler-template/main/scripts/release.ts | bun run -"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^22.10.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.72.0"
	},
	"overrides": {
		"moment": "^2.31.0"
	}
}
